# Copie ce fichier en ".env" sur la VM de test/prod, puis remplace CHAQUE valeur
# marquée CHANGEME par un vrai secret. Ne jamais committer le fichier ".env" rempli.

MONARC_IMAGE=ghcr.io/asinbenin/monarcappfo:master-asin

# Nom de domaine public de ce client/instance FO (ex: monarc.tonorganisation.lu).
# Utilisé par Traefik pour router vers ce conteneur ET pour obtenir le certificat
# Let's Encrypt automatique. Sur un test purement local sans domaine public
# joignable, Let's Encrypt échouera — teste alors seulement le routeur HTTP
# (voir README de test), le HTTPS ne peut être validé que sur la vraie VM.
DOMAIN_FO=CHANGEME_ton-domaine-ou-localhost

# Adresse email transmise à Let's Encrypt pour les notifications de certificat.
ACME_EMAIL=CHANGEME_admin@tonorganisation.lu

# Hôte de la base MariaDB, native (PAS conteneurisée — voir scripts/ensure_mariadb.sh).
# Depuis un conteneur, "host.docker.internal" atteint la machine hôte elle-même.
# Si la base tourne sur un serveur BO séparé, mets son adresse IP/hostname ici.
DBHOST=host.docker.internal

DBNAME_COMMON=monarc_common
DBNAME_CLI=monarc_cli
DBUSER_MONARC=monarc_prod
DBPASSWORD_MONARC=CHANGEME_mot_de_passe_fort
DBPASSWORD_ADMIN=CHANGEME_mot_de_passe_root_different

# 0 = ce FO possède/initialise sa propre base "common" (installation autonome).
# 1 = la base "common" est déjà gérée ailleurs (ex: un serveur BO central) —
#     ce FO ne la crée/modifie jamais, il la lit seulement. Voir le schéma
#     d'architecture officiel (RPX/BO/FO) pour ce second cas.
USE_BO_COMMON=0

CAPTCHA_ENABLED=true
PDF_CONVERTER_BINARY=/usr/bin/soffice

# TrustedX (SSO PKI) — mêmes valeurs que celles configurées côté TrustedX pour cet environnement
TRUSTEDX_URL=
TRUSTEDX_CLIENT_ID=
TRUSTEDX_CLIENT_SECRET=

# Clé de chiffrement AES-256-GCM des tokens SSO en base — générer avec :
#   openssl rand -base64 32
MONARC_SSO_ENCRYPTION_KEY=CHANGEME_genere_avec_openssl_rand_-base64_32

MONARC_NETWORK_NAME=monarc-network
